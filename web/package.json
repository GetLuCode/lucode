{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "alias": {
    "@/*": "./src/$1"
  },
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.parcel-cache',{recursive:true,force:true})\" && node --no-warnings --unhandled-rejections=warn ./node_modules/parcel/lib/bin.js index.html --port 5173",
    "build": "tsc -b && parcel build index.html --dist-dir dist",
    "lint": "eslint .",
    "test": "node --test tests/pendingHooks.test.ts tests/highlight.test.ts tests/hookSummary.test.ts tests/commandLine.test.ts tests/tokenPricing.test.ts tests/toolCosts.test.ts tests/flows.test.ts tests/git.test.ts tests/push.test.ts tests/plugins.test.ts tests/sanitize.test.ts tests/pluginSurface.test.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@xstate/react": "6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.2",
    "dompurify": "3.4.17",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.12.0",
    "litegraph.js": "0.7.18",
    "marked": "^17.0.5",
    "mermaid": "^11.12.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-medium-image-zoom": "^5.4.2",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "reconnecting-websocket": "^4.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "vosk-browser": "0.0.8",
    "xstate": "5.33.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/transformer-webmanifest": "2.16.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "buffer": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "http-proxy-middleware": "^2.0.11",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17"
    }
  }
}
