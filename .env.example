# Copy to .env (git-ignored) and fill in. Only placeholders belong in this file.

# NATS de desarrollo: carpeta de JetStream
LUCODE_NATS_DATA_DIR=C:\path\to\nats-data

# Runner en Kali
LUCODE_KALI_HOST=kali.example
LUCODE_KALI_IP=192.0.2.8
LUCODE_KALI_USER=user
LUCODE_KALI_HOME=/home/user
LUCODE_KALI_PROBE_HOST=kali-hostname
# IP del hub (Windows) vista desde Kali
LUCODE_HUB_IP=192.0.2.5

# Worker de voz (otro proyecto)
LUCODE_STT_DIR=C:\path\to\SttApp
LUCODE_STT_PYTHON=C:\path\to\venv\Scripts\python.exe
LUCODE_STT_VOSK_DIR=C:\path\to\vosk-model-small-es-0.42
